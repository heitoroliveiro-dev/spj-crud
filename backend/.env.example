# Copie este arquivo para .env e ajuste os valores para rodar o backend localmente sem Docker.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spj_db?schema=public
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:3001

# Segredo usado para assinar o JWT de sessão — troque por um valor aleatório longo
# (ex.: `openssl rand -base64 48`). Nunca reutilize o mesmo valor entre ambientes.
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Credenciais da Brevo (https://app.brevo.com) para envio dos e-mails de verificação de
# cadastro e redefinição de senha. Sem isso configurado, o backend sobe normalmente, mas
# signup/forgot-password retornam erro ao tentar enviar o e-mail.
BREVO_API_KEY=
EMAIL_FROM=naoresponda@seudominio.com
