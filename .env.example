# Copie este arquivo para .env na raiz do projeto para customizar variáveis lidas pelo
# docker-compose.yml. Sem este arquivo, o `docker compose up --build` funciona normalmente
# para o CRUD de processos/andamentos, mas os e-mails de verificação/reset de senha não são
# enviados de verdade (sem BREVO_API_KEY configurada).

# Segredo do JWT de sessão — troque em qualquer uso além de teste local.
JWT_SECRET=dev-secret-apenas-para-uso-local-nao-usar-em-producao

# Credenciais da Brevo (https://app.brevo.com) para envio real de e-mail em ambiente local.
BREVO_API_KEY=
EMAIL_FROM=naoresponda@localhost
